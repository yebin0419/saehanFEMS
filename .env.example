# === Phase 2 — DB 영속화 (Supabase) ===
# 미설정 시 로컬 파일시스템(./.data/)에 저장됩니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 서버에서만 사용. 공개 저장소에 커밋 금지.
SUPABASE_SERVICE_ROLE_KEY=

# === Phase 3 — 알림 / Resend ===
# https://resend.com/api-keys 에서 발급.
RESEND_API_KEY=
# 발신자 (Resend에서 검증된 도메인 사용).
ALERT_FROM="saehanFEMS <alerts@example.com>"
# 수신자 기본값 (DB 설정이 비어 있을 때 fallback). 쉼표로 구분.
ALERT_RECIPIENTS=
# 이메일 내 "대시보드에서 보기" 링크용. 운영 URL (예: https://fems.vercel.app).
NEXT_PUBLIC_APP_URL=

# === Phase 3 — Vercel Cron 보안 ===
# 설정 시 /api/alerts/dispatch 는 Authorization: Bearer <값> 헤더가 있을 때만 응답.
CRON_SECRET=

# === Phase 5 — IoT 수집 보안 ===
# 설정 시 /api/ingest/current + /api/equipments POST는 Authorization: Bearer <값> 또는
# X-Ingest-Key: <값> 헤더가 있을 때만 응답. 미설정 시 dev 환경에서는 모두 허용됩니다.
INGEST_API_KEY=
